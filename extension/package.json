{
  "name": "mddlmn",
  "displayName": "mddlmn-dev",
  "description": "Local control layer for Claude Code and Anthropic API traffic — inspect, edit, redact, inject, and gate every request before it leaves your machine.",
  "version": "0.1.2",
  "publisher": "juliankim",
  "license": "MIT",
  "icon": "icon.jpeg",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliank1m/mddlmn.git"
  },
  "bugs": {
    "url": "https://github.com/juliank1m/mddlmn/issues"
  },
  "homepage": "https://github.com/juliank1m/mddlmn#readme",
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "ai",
    "agent",
    "proxy",
    "observability",
    "llm",
    "prompt",
    "interceptor"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:mddlmn.openPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mddlmn.openPanel",
        "title": "mddlmn: Open Panel"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:proxy": "cd .. && npm run build && cd extension && node scripts/copy-proxy.mjs",
    "package": "npm run build && npm run build:proxy && vsce package --out mddlmn-${npm_package_version}.vsix --allow-missing-repository"
  },
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.8.3"
  }
}
